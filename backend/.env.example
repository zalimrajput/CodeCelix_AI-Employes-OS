# backend/.env.example
# Copy to .env and fill in the values below.

# ---------------------------------------------------------------------------
# PostgreSQL (Supabase). Format: postgresql+psycopg2://user:pass@host:port/db
# Get the exact URL from: supabase status  OR  Supabase Dashboard → Settings → Database
# DATABASE_URL is the single most critical variable — the app will not start
# without it.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@HOST:5432/dbname


# ---------------------------------------------------------------------------
# Supabase Auth
# Fetch from: Supabase Dashboard → Settings → API
# - SUPABASE_JWT_SECRET is required for OFFLINE token verification
#   (no extra network round-trip per request).
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret


# ---------------------------------------------------------------------------
# JWT & Encryption
#
# JWT_SECRET_KEY     — Fallback for ENCRYPTION_KEY only (set both or just
#                       ENCRYPTION_KEY). Leave empty if ENCRYPTION_KEY is set.
# ENCRYPTION_KEY     — Used to encrypt DB fields (integration tokens, etc).
#                       Generate with:
#                         python -c "import base64, os;
#                         print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# Recommended: set ENCRYPTION_KEY, leave JWT_SECRET_KEY blank.
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=
ENCRYPTION_KEY=


# ---------------------------------------------------------------------------
# AI / LLM providers (at least one is required for chat features)
# - OPTIONAL: set one of these to enable the AI features.
# Google embedding fallback requires GOOGLE_EMBEDDING_MODEL + (if set) GOOGLE_AI_KEY.
# - Default model is gemini-2.5-flash if no key is set (but API calls will fail).
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# OpenRouter unifies OpenAI, Anthropic, Google, DeepSeek, etc. in one API and
# exposes every model via OpenAI-compatible chat/completions. Use it as the
# single key when you want one credential to cover the whole fallback chain.
#
# Models whose ids carry a vendor prefix (e.g. "deepseek/deepseek-chat",
# "google/gemma-...", ":free" variants) or that ship through OpenRouter's
# catalog are ALWAYS routed via OpenRouter (never to the direct provider).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# When true, chat turns that would go to OpenAI, Anthropic or Google will
# silently retry through OpenRouter when the matching direct provider key is
# missing/invalid but OpenROUTER_API_KEY is set. With a single valid key plus
# a fallback chain of OpenRouter catalog models, chat keeps working even on
# unfunded/free-tier accounts.
#
# When false (default), those providers fail the normal way so a missing/invalid
# key produces a loud, fast error instead of a silent retry through OpenRouter.
OPENROUTER_AUTO_FALLBACK=false

# Per-employee model override. Employees without an explicit model use this.
# Keep it multimodal-capable so screenshot/attachment turns still work.
DEFAULT_AI_MODEL=gemini-2.5-flash

# Ordered comma-separated fallbacks tried one-by-one when the primary model
# fails with a retryable provider error (402 no credits, 429 rate limit, 5xx).
# Free/open models are transiently rate-limited, so a chain like this keeps
# chat alive even on an unfunded account. Models with vendor prefixes or
# ":free" suffixes in their ids are always routed through OpenRouter.
#
# Examples (single OPENROUTER_API_KEY covers the whole chain):
#   AI_MODEL_FALLBACKS=deepseek/deepseek-chat:gemini-2.5-flash-lite:gemini-2.0-flash-lite
#   AI_MODEL_FALLBACKS=openai/gpt-4o-mini,gemini-2.5-flash-lite,gemini-2.0-flash-lite
AI_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-2.0-flash-lite


# ---------------------------------------------------------------------------
# Stripe (payments — optional if you're not using Stripe checkout/billing)
# - Both webhook secrets can point to the same value if you only have one
#   endpoint; the second falls back to the first when unset.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
# Service integrations — these are per-org OAuth credentials stored in the
# database. They're NOT required to stand up the backend, only to provide the
# integrations features (Gmail, Calendar, Drive, Sheets, Outlook, OneDrive,
# Microsoft 365, Zoho CRM, Xero, Slack, WhatsApp, etc.).
#
# They DO NOT go in Faable/Vercel deployment env vars — that's by design.
# Instead each organization connects them via the app's Settings → Integrations,
# and the tokens are stored (encrypted) in the Supabase database. The below
# values are only needed if you want to pre-configure platform-level defaults.
# ---------------------------------------------------------------------------
# Gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/callback/google

# Google Calendar / Drive / Sheets share the same Google OAuth client
GOOGLE_CAL_CLIENT_ID=
GOOGLE_CAL_CLIENT_SECRET=

# Outlook / Microsoft 365 / OneDrive
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_BOT_TOKEN=

# Zoho CRM
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_DATA_CENTER=com

# Xero
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# WhatsApp
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# Storage backend (local | s3 | r2). S3/R2 optional if using local filesystem.
STORAGE_PROVIDER=local
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=


# ---------------------------------------------------------------------------
# Infra / observability
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
FRONTEND_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_MINUTE=600
AUDIT_LOG_ENABLED=true


# ---------------------------------------------------------------------------
# Optional override of the async AI worker/celery command via env var.
# (Celery is best-effort when Redis is down; the app still works without it.)
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

