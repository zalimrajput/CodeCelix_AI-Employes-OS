# frontend/.env.example
# Copy to .env.local (Next.js convention) and fill in the values below.

# ---------------------------------------------------------------------------
# Supabase client for the browser (Next.js public vars, prefixed NEXT_PUBLIC_)
# Fetch from: Supabase Dashboard → Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key


# ---------------------------------------------------------------------------
# Backend base URL. Used by the frontend API client to call FastAPI.
#
# Development:  http://localhost:8000
# Staging/Prod: https://your-api.faable.co  (or wherever backend is deployed)
#
# NEXT_PUBLIC_BACKEND_URL must match the origin allowed by the backend's CORS
# configuration (backend/app/main.py → FRONTEND_ORIGIN).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
